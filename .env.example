# Local ADMIN settings. Copy to .env; keep real values outside Git.
CLIENT_ID=
CLIENT_SECRET=
CLIENT_ID_US=
CLIENT_SECRET_US=
AHGEN_REGION=eu

# Public web deployment. The example hostname does not point to a real service.
PUBLIC_ORIGIN=https://example.invalid
SUPPORT_URL=/profile
SUPPORT_LABEL=поддержка

# Optional public licensing values; alternative to public_config.json.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Leave blank to generate a strong persistent .flask_secret locally.
FLASK_SECRET=

# Optional analytics; real IDs belong only in local configuration.
GA_MEASUREMENT_ID=
YANDEX_METRIKA_ID=

# Standalone collector options. Flask stays on 8765.
WS_HOST=127.0.0.1
WS_PORT=8766
STREAM_ENABLED=1
WRITE_AUCTION_LATEST=1
MONITOR_COUNT=15
CHECK_REALM_IDS=
CHECK_REALM_IDS_US=
